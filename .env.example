# MONGODB_URI: MongoDB connection string (e.g. MongoDB Atlas free tier cluster).
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studentspend?retryWrites=true&w=majority
# On Render: Add this in your Web Service "Environment Variables" panel.
# Crucial Atlas Note: Whitelist IP 0.0.0.0/0 under Network Access in MongoDB Atlas so Render can connect.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/studentspend?retryWrites=true&w=majority"

# NODE_ENV: Set to production for live deployment
NODE_ENV="production"

# PORT: Server port (Render automatically assigns PORT=10000; defaults to 3000 locally)
PORT=3000

# GEMINI_API_KEY: Optional. For Gemini 3.8 Flash financial coaching & transaction categorization.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL of the deployed app (e.g., https://your-app.onrender.com)
APP_URL="MY_APP_URL"
